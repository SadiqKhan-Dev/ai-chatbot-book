# AI Assistant RAG - Production Environment Configuration
# Copy this file to .env and fill in the actual values

# =============================================================================
# OpenAI Configuration
# Get your API key from: https://platform.openai.com/api-keys
# =============================================================================
OPENAI_API_KEY=sk-prod-your-openai-api-key-here
OPENAI_CHAT_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# =============================================================================
# Qdrant Cloud Configuration
# Get your credentials from: https://cloud.qdrant.io
# =============================================================================
QDRANT_URL=https://your-cluster.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key-here
QDRANT_COLLECTION_NAME=ai-assistant-book

# =============================================================================
# Cohere Configuration (Optional - for alternative embeddings)
# Get your API key from: https://dashboard.cohere.com/api-keys
# =============================================================================
COHERE_API_KEY=your-cohere-api-key-here
COHERE_EMBEDDING_MODEL=embed-english-v3.0

# =============================================================================
# Hugging Face Configuration (Optional - for local embeddings)
# =============================================================================
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# =============================================================================
# Embedding Provider Selection
# Options: openai, cohere, huggingface
# =============================================================================
EMBEDDING_PROVIDER=openai

# =============================================================================
# Application Configuration
# =============================================================================
DEBUG=false
LOG_LEVEL=INFO

# =============================================================================
# RAG Pipeline Configuration
# =============================================================================
RELEVANCE_THRESHOLD=0.7
MAX_RETRIEVAL_RESULTS=5
MAX_TOKENS_IN_RESPONSE=1000
CONVERSATION_HISTORY_LIMIT=50
